{
  "name": "cutright-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "test": "vitest run --environment jsdom",
    "tauri": "tauri",
    "qa:browser": "bash scripts/qa-browser.sh",
    "qa:browser:stop": "bash scripts/qa-browser-stop.sh",
    "qa:functional": "node scripts/qa-functional.mjs",
    "qa:shot": "node scripts/qa-shot.mjs",
    "check:mac-rpath": "bash scripts/check-macos-rpath.sh",
    "release:doctor": "right-release doctor",
    "release:build:mac": "right-release build --platform mac",
    "release:upload:patch:mac": "right-release upload --platform mac --tier patch",
    "release:upload:update:mac": "right-release upload --platform mac --tier update",
    "rightkit:package:mac": "node scripts/package-mac.mjs --notarize"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.0.18",
    "jsdom": "^27.4.0",
    "@rightkit/release": "0.2.50"
  }
}
