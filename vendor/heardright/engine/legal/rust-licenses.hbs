<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>HeardRight Rust third-party licenses</title></head>
<body>
<h1>HeardRight Rust third-party licenses</h1>
<p>Generated from Cargo.lock for the supported Windows and macOS targets. This appendix is part of the HeardRight distribution.</p>
{{#each licenses}}
<section>
  <h2>{{name}} ({{id}})</h2>
  <p>Used by:</p>
  <ul>{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>{{/each}}</ul>
  <pre>{{text}}</pre>
</section>
{{/each}}
</body>
</html>
