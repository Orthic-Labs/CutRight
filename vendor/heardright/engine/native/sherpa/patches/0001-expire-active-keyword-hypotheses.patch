 namespace sherpa_onnx {
 
+namespace {
+
+// Keyword timestamps use 40 ms subsampled frames. Production phrases finish
+// within 1.12 seconds; 38 frames retain 1.52 seconds while preventing an old
+// partial context path from surviving into a later command attempt.
+constexpr int32_t kMaxKeywordActiveFrames = 38;
+
+bool KeywordPathExpired(const Hypothesis &hyp, int32_t current_frame) {
+  if (hyp.context_state == nullptr || hyp.context_state->level <= 0) {
+    return false;
+  }
+
+  auto level = static_cast<size_t>(hyp.context_state->level);
+  if (hyp.timestamps.size() < level) {
+    return false;
+  }
+
+  int32_t first_frame = hyp.timestamps[hyp.timestamps.size() - level];
+  return current_frame - first_frame > kMaxKeywordActiveFrames;
+}
+
+}  // namespace
