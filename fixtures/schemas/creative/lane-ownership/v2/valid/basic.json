      "crates": ["video-core/writing"]
    },
    {
      "id": "social",
      "name": "Social",
      "decision_rights": ["platform-fit"],
      "crates": ["video-core/social"]
    },
    {
      "id": "planning",
      "name": "Creative Planning",
      "decision_rights": ["creative-plan", "bake-off"],
