      "crates": ["video-core/native_typography"]
    },
    {
      "id": "native-motion",
      "name": "Native Motion",
      "decision_rights": ["motion-grammar"],
      "crates": ["video-core/native_motion"]
    },
    {
      "id": "native-audio",
      "name": "Native Audio",
      "decision_rights": ["audio-finishing"],
      "crates": ["video-core/native_audio"]
    },
    {
      "id": "creative-critic",
      "name": "Creative Critic",
