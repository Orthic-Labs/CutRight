  "shared_contracts": [
    { "name": "skill-request", "owners": ["planning", "brand", "designer", "writing", "social"] },
    { "name": "asset-delivery", "owners": ["designer", "writing", "native-renderer"] },
    { "name": "finish-plan", "owners": ["native-renderer", "planning", "creative-critic"] }
