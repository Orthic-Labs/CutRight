{
  "version": "v2",
  "stage": "bake-off",
  "producer": "planning",
  "consumer": "planning",
  "input": {
    "kind": "style_direction",
    "schema": "schemas/creative/style-direction.schema.v2.json",
    "id_required": true
  },
  "output": {
    "kind": "bakeoff",
