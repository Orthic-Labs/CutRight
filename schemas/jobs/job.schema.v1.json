{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cutright.dev/schemas/jobs/job.schema.v1.json",
  "title": "CutRight v2 job (v1)",
  "description": "A durable, content-addressed job that executes a DAG of stages. A job is the unit of resume, retry, and cancellation. Terminal statuses are `succeeded`, `needs_review`, `failed`, `cancelled`; success is never inferred from process exit alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "job_id",
    "fingerprint",
    "stages",
    "status",
    "created_at_ns",
    "updated_at_ns"
  ],
  "properties": {
    "schema": {"const": "cutright.job/v1"},
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "kind": {
      "enum": [
        "ingest",
        "transcribe",
        "tag",
        "plan",
        "score",
        "render",
        "export",
        "verify",
        "migrate"
      ]
    },
    "fingerprint": {"$ref": "fingerprint.schema.v1.json"},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "stage.schema.v1.json"}
    },
    "status": {
      "enum": ["pending", "running", "succeeded", "needs_review", "failed", "cancelled"]
    },
    "created_at_ns": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at_ns": {
      "type": "integer",
      "minimum": 1
    },
    "started_at_ns": {
      "type": "integer",
      "minimum": 1
    },
    "completed_at_ns": {
      "type": "integer",
      "minimum": 1
    },
    "last_error": {
      "$ref": "#/definitions/structured_error"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "actor_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}
      }
    },
    "preferences_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "definitions": {
    "structured_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]+$"
        },
        "message": {"type": "string", "maxLength": 2048},
        "stage_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
        "retryable": {"type": "boolean"},
        "diagnostics": {
          "type": "object",
          "description": "Bounded diagnostics map."
        }
      }
    }
  }
}
