{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cutright.dev/schemas/jobs/fingerprint.schema.v1.json",
  "title": "CutRight v2 job fingerprint (v1)",
  "description": "Content-derived fingerprint used to de-duplicate, cache-hit, and resume jobs and stages. The fingerprint is the BLAKE3 hash of a canonicalised JSON object containing source hashes, parameters, capability version, pack locks, schema ids, and the preference hash. A change in any field invalidates the fingerprint.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "fingerprint",
    "composed_at_ns"
  ],
  "properties": {
    "schema": {"const": "cutright.job_fingerprint/v1"},
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "BLAKE3 hash of the canonicalised input body."
    },
    "source_hashes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "blake3"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "blake3": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "parameters_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "capability_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "pack_locks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pack_id", "version", "lock_hash"],
        "properties": {
          "pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "lock_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "sha256"],
        "properties": {
          "uri": {"type": "string", "format": "uri"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "preference_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "composed_at_ns": {
      "type": "integer",
      "minimum": 1
    }
  }
}
