{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "cutright.agent.editorial_plan_draft/v1",
  "title": "CutRight EditorialPlanDraft",
  "description": "Strict, non-durable provider output. CutRight compiles it before any canonical EditorialPlan bytes can cross a durable boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "plan_id", "source_revision", "evidence_graph_revision", "policy_version", "beats", "order", "reorder_logs", "escalations", "drop_reasons", "chronological_status", "review_flags"],
  "properties": {
    "schema": { "const": "cutright.agent.editorial_plan_draft/v1" },
    "schema_version": { "const": 2 },
    "plan_id": { "type": "string", "minLength": 1 },
    "source_revision": { "type": "string", "minLength": 1 },
    "evidence_graph_revision": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "beats": { "type": "array", "items": { "$ref": "#/$defs/beat" } },
    "order": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "reorder_logs": { "type": "array", "items": { "$ref": "#/$defs/reorder_log" } },
    "escalations": { "type": "array", "items": { "$ref": "#/$defs/escalation" } },
    "drop_reasons": { "type": "array", "items": { "$ref": "#/$defs/drop_reason" } },
    "chronological_status": { "enum": ["truthful", "truthful_with_disclosed_reorder", "false_chronology_blocked"] },
    "review_flags": { "type": "array", "items": { "$ref": "#/$defs/review_flag" } },
    "review_mode": { "enum": ["Reviewed", "ReviewLight", "Autonomous"] }
  },
  "$defs": {
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beat_id", "label", "selected_take", "alternates", "confidence", "evidence"],
      "properties": {
        "beat_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "selected_take": { "type": "string", "minLength": 1 },
        "alternates": { "type": "array", "items": { "$ref": "#/$defs/take_score" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "notes": { "type": "string" }
      }
    },
    "take_score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "scores", "weight_total", "missing_evidence", "hard_faults", "total", "winner_margin"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "scores": { "$ref": "#/$defs/scores" },
        "weight_total": { "type": "number", "minimum": 0 },
        "missing_evidence": { "type": "array", "items": { "type": "string" } },
        "hard_faults": { "type": "array", "items": { "type": "string" } },
        "total": { "type": "number", "minimum": 0 },
        "winner_margin": { "type": "number" },
        "status": { "type": "string" }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery", "completeness", "technical", "hook_strength", "payoff_strength"],
      "properties": {
        "delivery": { "type": "number", "minimum": 0, "maximum": 1 },
        "completeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "technical": { "type": "number", "minimum": 0, "maximum": 1 },
        "hook_strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "payoff_strength": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_range"],
      "properties": {
        "source_range": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 } },
        "word_ids": { "type": "array", "items": { "type": "string" } },
        "frame_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "reorder_log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_index", "to_index", "reason", "claim_dependencies"],
      "properties": {
        "from_index": { "type": "integer", "minimum": 0 },
        "to_index": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1 },
        "claim_dependencies": { "type": "array", "items": { "type": "string" } }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["escalation_id", "kind", "blocking", "summary", "evidence_refs"],
      "properties": {
        "escalation_id": { "type": "string" },
        "kind": { "type": "string" },
        "blocking": { "type": "boolean" },
        "summary": { "type": "string" },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "review_mode_target": { "type": "string" },
        "raised_by": { "type": "string" }
      }
    },
    "drop_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "reason"],
      "properties": { "candidate_id": { "type": "string" }, "reason": { "type": "string" } }
    },
    "review_flag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flag", "evidence_refs"],
      "properties": { "flag": { "type": "string" }, "evidence_refs": { "type": "array", "items": { "type": "string" } } }
    }
  }
}
