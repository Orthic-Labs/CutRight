{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutright.local/schemas/finish-plan.schema.json",
  "title": "CutRight finish plan",
  "oneOf": [
    {"$ref": "#/$defs/legacyPlan"},
    {"$ref": "#/$defs/lockedPlan"}
  ],
  "$defs": {
    "legacyPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "base_timeline", "slots"],
      "properties": {
        "schema_version": {"const": 1},
        "base_timeline": {"type": "string", "minLength": 1},
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "renderer", "effect_id", "output_start_ms", "output_end_ms"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "minLength": 1},
              "renderer": {"enum": ["native", "legacy", "render.final"]},
              "effect_id": {"type": "string", "minLength": 1},
              "output_start_ms": {"type": "integer", "minimum": 0},
              "output_end_ms": {"type": "integer", "minimum": 0},
              "anchor": {"type": ["string", "null"]},
              "collision_policy": {"type": ["string", "null"]},
              "props": {"type": "object"}
            }
          }
        }
      }
    },
    "lockedPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "lockedCutSha256", "graph"],
      "properties": {
        "schemaVersion": {"const": 1},
        "lockedCutSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "graph": {"$ref": "#/$defs/graph"},
        "auditionChoice": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["variantId", "sourceHashes"],
          "properties": {
            "variantId": {"type": "string", "minLength": 1},
            "sourceHashes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "sourcePath", "duration", "assets", "nodes"],
      "properties": {
        "schemaVersion": {"const": 1},
        "sourcePath": {"type": "string", "minLength": 1},
        "duration": {"$ref": "#/$defs/time"},
        "assets": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "nodes": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/graphNode"}}
      }
    },
    "graphNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start", "end", "inputs", "node"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "start": {"$ref": "#/$defs/time"},
        "end": {"$ref": "#/$defs/time"},
        "inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "node": {"$ref": "#/$defs/node"}
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "node": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "startScale", "endScale", "centerX", "centerY"], "properties": {"kind": {"const": "pullback"}, "startScale": {"type": "number"}, "endScale": {"type": "number"}, "centerX": {"type": "number"}, "centerY": {"type": "number"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "peakScale", "peakTime", "width"], "properties": {"kind": {"const": "punchWave"}, "peakScale": {"type": "number"}, "peakTime": {"$ref": "#/$defs/time"}, "width": {"$ref": "#/$defs/time"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "startScale", "endScale", "biasX", "biasY"], "properties": {"kind": {"const": "biasedPushIn"}, "startScale": {"type": "number", "minimum": 1}, "endScale": {"type": "number", "minimum": 1}, "biasX": {"type": "number"}, "biasY": {"type": "number"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "text", "startBlur", "risePx"], "properties": {"kind": {"const": "textBloom"}, "text": {"type": "string"}, "startBlur": {"type": "number", "minimum": 0}, "risePx": {"type": "number"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "lines", "stagger"], "properties": {"kind": {"const": "authorityStack"}, "lines": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "stagger": {"$ref": "#/$defs/time"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "assetId", "cell", "parallax"], "properties": {"kind": {"const": "assetPlacement"}, "assetId": {"type": "string", "minLength": 1}, "cell": {"type": "string", "minLength": 1}, "parallax": {"type": "number"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "assetId", "firstWordId", "lastWordId"], "properties": {"kind": {"const": "editorTakeover"}, "assetId": {"type": "string", "minLength": 1}, "firstWordId": {"type": "string", "minLength": 1}, "lastWordId": {"type": "string", "minLength": 1}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "cueId", "targetPeak"], "properties": {"kind": {"const": "audioCue"}, "cueId": {"type": "string", "minLength": 1}, "targetPeak": {"$ref": "#/$defs/time"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "sourceId", "split", "wetTailMs"], "properties": {"kind": {"const": "reverbThrow"}, "sourceId": {"type": "string", "minLength": 1}, "split": {"$ref": "#/$defs/time"}, "wetTailMs": {"type": "integer", "minimum": 1}}}
      ]
    }
  }
}
