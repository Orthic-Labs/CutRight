{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "cutright.studio.navigation/v1",
  "title": "StudioNavigation",
  "description": "Frozen Studio route state shape. UI state (selection, playhead, focused panel) lives in a sibling slice and is dropped on route change; this object is shallow and deterministic.",
  "type": "object",
  "required": ["schema", "mode"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "cutright.studio.navigation/v1"
    },
    "mode": {
      "type": "string",
      "enum": [
        "home",
        "sources",
        "transcript",
        "story",
        "beats",
        "timeline",
        "design",
        "motion-sound",
        "compare",
        "finals",
        "qa",
        "settings"
      ]
    },
    "project_id": { "type": "string" },
    "revision": { "type": "string" },
    "timeline_id": { "type": "string" },
    "evidence_id": { "type": "string" },
    "object_id": { "type": "string" },
    "capability_unavailable": { "type": "boolean" }
  }
}