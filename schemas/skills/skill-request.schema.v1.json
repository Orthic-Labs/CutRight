{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cutright.dev/schemas/skills/skill-request.schema.v1.json",
  "title": "CutRight v2 embedded skill request",
  "description": "Embedded creative skill execution contract — request envelope. Skills cannot request undeclared permissions, packs, or model/runtime capabilities. Direct filesystem and timeline mutation are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "skill_request_id",
    "skill_id",
    "skill_revision",
    "revision",
    "permissions",
    "capabilities",
    "resource_budget",
    "inputs",
    "output_targets",
    "deterministic"
  ],
  "properties": {
    "schema": { "const": "cutright.skill_request/v1" },
    "skill_request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "description": "Opaque caller-side identifier; used to correlate trace, result, and audit."
    },
    "skill_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]{2,127}$",
      "description": "Embedded skill identifier (e.g. 'designer.layout', 'brand.explore', 'writing.script')."
    },
    "skill_revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing skill revision; binds output to compiled skill bytecode hash."
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "revision_id"],
      "properties": {
        "project_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
        "revision_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
        "editorial_revision_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Optional: when set, skill MUST treat the editorial revision as immutable."
        }
      }
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "evidence_read",
          "asset_plan",
          "render_sample",
          "settings_read",
          "pack_manage",
          "voice_design",
          "audio_design"
        ]
      },
      "description": "Declared permission grants. Skills cannot request 'timeline_write', 'export', 'filesystem_raw', 'network', or 'shell_exec' — those values are not in the enum and will fail validation."
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "runtime"],
      "properties": {
        "model": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,127}$",
          "description": "Declared model capability ID. Must be resolvable against the capability registry."
        },
        "runtime": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,127}$",
          "description": "Declared runtime pack capability ID. Must be resolvable against the capability registry."
        },
        "fallback": {
          "type": "string",
          "enum": ["none", "deterministic", "user_supplied"]
        }
      }
    },
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wallclock_ms", "memory_mb", "tokens_in", "tokens_out"],
      "properties": {
        "wallclock_ms": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "memory_mb": { "type": "integer", "minimum": 1, "maximum": 32768 },
        "tokens_in": { "type": "integer", "minimum": 0, "maximum": 2000000 },
        "tokens_out": { "type": "integer", "minimum": 0, "maximum": 2000000 },
        "model_calls": { "type": "integer", "minimum": 0, "maximum": 1024 }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brief"],
      "properties": {
        "brief": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["evidence_id", "kind"],
            "properties": {
              "evidence_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
              "kind": {
                "enum": [
                  "transcript_segment",
                  "frame",
                  "audio_segment",
                  "face_track",
                  "logo_track",
                  "label_track",
                  "saliency_map",
                  "document",
                  "brand_card",
                  "style_direction"
                ]
              },
              "selector": { "type": "string", "maxLength": 512 }
            }
          }
        },
        "context": { "type": "object" }
      }
    },
    "output_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "skill_plan",
          "asset_request",
          "asset_delivery",
          "asset_review",
          "creative_verdict",
          "finish_plan",
          "copy_document",
          "review_finding"
        ]
      },
      "description": "Permitted typed artefact outputs."
    },
    "deterministic": {
      "type": "boolean",
      "description": "When true, identical inputs/seed/pack MUST produce stable structured outputs."
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "Optional seed for deterministic skills."
    },
    "degradation_policy": {
      "type": "string",
      "enum": ["abort", "needs_review", "deterministic_fallback"],
      "default": "needs_review"
    }
  }
}
