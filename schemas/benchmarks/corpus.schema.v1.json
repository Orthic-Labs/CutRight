{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutright.local/schemas/benchmarks/corpus.schema.v1.json",
  "title": "CutRight v2 benchmark corpus manifest",
  "type": "object",
  "required": ["schema_version", "generated_at", "splits", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "splits": {
      "type": "object",
      "required": ["train", "calibration", "test"],
      "properties": {
        "train": { "type": "array", "items": { "type": "string" } },
        "calibration": { "type": "array", "items": { "type": "string" } },
        "test": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "project_id",
          "lane",
          "split",
          "source_hashes",
          "rights_ref",
          "redistributable",
          "expected_language",
          "conditions",
          "labels",
          "allowed_distribution"
        ],
        "properties": {
          "project_id": { "type": "string", "minLength": 1 },
          "lane": {
            "enum": [
              "recorded",
              "repurpose",
              "explainer",
              "anchored_creative",
              "adversarial"
            ]
          },
          "split": { "enum": ["train", "calibration", "test"] },
          "source_hashes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^blake3:[a-f0-9]{64}$" }
          },
          "rights_ref": { "type": "string", "minLength": 1 },
          "redistributable": { "type": "boolean" },
          "expected_language": { "type": "string", "minLength": 2 },
          "conditions": {
            "type": "object",
            "required": ["frame_rate", "audio_channels"],
            "properties": {
              "frame_rate": { "type": "number" },
              "audio_channels": { "type": "integer", "minimum": 1 },
              "room_tone": { "type": "string" },
              "lighting": { "type": "string" },
              "camera_handling": { "type": "string" }
            },
            "additionalProperties": true
          },
          "labels": {
            "type": "object",
            "required": ["reviewer_ids"],
            "properties": {
              "reviewer_ids": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "annotation_paths": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": true
          },
          "allowed_distribution": {
            "enum": ["local_only", "redistributable"]
          },
          "missing_fixture": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "missing": {
      "type": "object",
      "description": "Placeholder rows MUST set missing_fixture=true so the runner excludes them."
    }
  }
}
