{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutright.local/schemas/benchmarks/critic-verdict.schema.v1.json",
  "title": "CutRight v2 critic verdict",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "metric_id",
    "evaluator",
    "evaluator_version",
    "status",
    "evidence_refs",
    "rationale",
    "confidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "metric_id": { "type": "string", "minLength": 1 },
    "evaluator": {
      "enum": ["critic-A", "critic-B", "deterministic", "planner-A"]
    },
    "evaluator_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "seed": { "type": "integer" },
    "status": {
      "enum": ["pass", "fail", "skipped_with_reason", "unsupported", "unproven"]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [],
        "properties": {
          "source_range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "integer", "minimum": 0 }
          },
          "output_range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "integer", "minimum": 0 }
          },
          "frame_refs": { "type": "array", "items": { "type": "string" } },
          "word_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "rationale": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "log_only": { "type": "boolean" },
    "revision_count": { "type": "integer", "minimum": 0, "maximum": 1 }
  }
}
