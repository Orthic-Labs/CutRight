{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutright.local/schemas/project.schema.json",
  "title": "CutRight project manifest",
  "type": "object",
  "required": ["schema_version", "project_id", "kind", "created_at", "review_mode", "source_policy", "outputs"],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "review_mode": { "enum": ["reviewed", "review-light", "autonomous"] },
    "source_policy": { "const": "immutable" },
    "outputs": { "type": "array", "items": { "$ref": "#/$defs/output" } }
  },
  "$defs": {
    "output": {
      "type": "object",
      "required": ["id", "aspect", "width", "height"],
      "properties": {
        "id": { "type": "string" },
        "aspect": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
