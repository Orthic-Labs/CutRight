{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cutright/schemas/import/source-corpus.schema.v1.json",
  "title": "CutRight v2 source corpus manifest",
  "description": "Machine-readable frozen corpus for the CutRight v2 import programme. Every source in CutRight-v2-Source-Corpus-and-Ledger.md must appear exactly once. Mutable branches are invalid revisions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_date", "claim", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "corpus_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "claim": { "type": "string", "minLength": 10 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/source" }
    }
  },
  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "name",
        "kind",
        "canonical_url",
        "revision_type",
        "revision",
        "license_status",
        "disposition",
        "copy_source",
        "allowed_paths",
        "excluded_paths",
        "destination",
        "notice_requirements"
      ],
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["codebase", "runtime", "model_weights", "asset_bundle", "attachment", "research"]
        },
        "canonical_url": { "type": "string", "pattern": "^https://" },
        "revision_type": {
          "enum": ["commit", "tag_resolved_to_commit", "model_revision", "attachment_hash", "published_reference"]
        },
        "revision": {
          "type": "string",
          "minLength": 7,
          "not": { "enum": ["main", "master", "latest", "HEAD", "develop", "dev"] }
        },
        "license_status": {
          "enum": [
            "mit",
            "apache_2_0",
            "lgpl_2_1_or_later_build_only",
            "gpl_3_0_clean_room_only",
            "user_owned_with_third_party_notices",
            "user_supplied_audited_separately",
            "apache_2_0_weights_voices_audited_separately",
            "no_declared_license",
            "citation_only"
          ]
        },
        "disposition": {
          "enum": [
            "ship_source",
            "ship_runtime_pack",
            "adapt_with_notice",
            "clean_room_behavior",
            "provenance_only",
            "development_only",
            "excluded_with_reason",
            "blocked_unresolved"
          ]
        },
        "copy_source": { "type": "boolean" },
        "allowed_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "excluded_paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "destination": { "type": "string", "minLength": 1 },
        "notice_requirements": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "revision_type": { "enum": ["commit", "tag_resolved_to_commit"] } } },
          "then": { "properties": { "revision": { "pattern": "^[0-9a-f]{40}$" } } }
        },
        {
          "if": { "properties": { "revision_type": { "const": "model_revision" } } },
          "then": { "properties": { "revision": { "pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$" } } }
        },
        {
          "if": { "properties": { "revision_type": { "const": "attachment_hash" } } },
          "then": { "properties": { "revision": { "pattern": "^attachment-manifest:[A-Za-z0-9._/-]+$" } } }
        },
        {
          "if": { "properties": { "revision_type": { "const": "published_reference" } } },
          "then": { "properties": { "revision": { "pattern": "^[A-Za-z0-9][A-Za-z0-9.:_-]*$" } } }
        },
        {
          "if": { "properties": { "disposition": { "enum": ["clean_room_behavior"] } } },
          "then": { "properties": { "copy_source": { "const": false } } }
        }
      ]
    }
  }
}
