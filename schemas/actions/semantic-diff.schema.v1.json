{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cutright.dev/schemas/actions/semantic-diff.schema.v1.json",
  "title": "CutRight v2 semantic dry-run diff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "batch_id",
    "expected_revision",
    "planned_revision",
    "diff"
  ],
  "properties": {
    "schema": {
      "const": "cutright.semantic_diff/v1"
    },
    "batch_id": {
      "type": "string"
    },
    "expected_revision": {
      "type": "string"
    },
    "planned_revision": {
      "type": "string"
    },
    "diff": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action_kind",
          "target_id",
          "after_id",
          "before_id",
          "range",
          "duration_delta_ns"
        ],
        "properties": {
          "action_kind": {
            "type": "string"
          },
          "target_id": {
            "type": "string"
          },
          "before_id": {
            "type": "string"
          },
          "after_id": {
            "type": "string"
          },
          "range": {
            "type": "object",
            "properties": {
              "start_ns": {
                "type": "integer"
              },
              "end_ns": {
                "type": "integer"
              }
            }
          },
          "duration_delta_ns": {
            "type": "integer"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "risk_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}