{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cutright.dev/schemas/actions/action-batch.schema.v1.json",
  "title": "CutRight v2 action batch envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "batch_id",
    "expected_revision",
    "intent",
    "actions",
    "dry_run"
  ],
  "properties": {
    "schema": {
      "const": "cutright.action_batch/v1"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "expected_revision": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "target",
          "params"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]+$"
          },
          "target": {
            "type": "string"
          },
          "params": {
            "type": "object"
          }
        }
      }
    },
    "dry_run": {
      "type": "boolean"
    }
  }
}