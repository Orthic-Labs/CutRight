{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cutright.dev/schemas/actions/action-result.schema.v1.json",
  "title": "CutRight v2 action apply result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "batch_id",
    "status",
    "new_revision",
    "receipt_id"
  ],
  "properties": {
    "schema": {
      "const": "cutright.action_result/v1"
    },
    "batch_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "applied",
        "dry_run",
        "failed"
      ]
    },
    "new_revision": {
      "type": "string"
    },
    "receipt_id": {
      "type": "string"
    },
    "applied_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message",
          "action_index"
        ],
        "properties": {
          "code": {
            "enum": [
              "stale_revision",
              "missing_target",
              "invalid_range",
              "permission_denied",
              "resource_limit",
              "partial_output",
              "unknown_action_kind",
              "validation_error"
            ]
          },
          "message": {
            "type": "string"
          },
          "action_index": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}