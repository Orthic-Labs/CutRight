{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cutright.dev/schemas/actions/inverse-batch.schema.v1.json",
  "title": "CutRight v2 inverse action batch (undo)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "original_batch_id",
    "inverse_actions"
  ],
  "properties": {
    "schema": {
      "const": "cutright.inverse_batch/v1"
    },
    "original_batch_id": {
      "type": "string"
    },
    "expected_revision": {
      "type": "string"
    },
    "inverse_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "target",
          "params"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "params": {
            "type": "object"
          }
        }
      }
    }
  }
}