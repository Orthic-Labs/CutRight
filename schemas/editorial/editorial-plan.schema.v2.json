{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutright.local/schemas/editorial/editorial-plan.schema.v2.json",
  "title": "CutRight v2 editorial plan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "source_revision",
    "evidence_graph_revision",
    "policy_version",
    "beats",
    "order",
    "reorder_logs",
    "escalations",
    "drop_reasons",
    "chronological_status",
    "review_flags"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "plan_id": { "type": "string", "minLength": 1 },
    "source_revision": { "type": "string", "minLength": 1 },
    "evidence_graph_revision": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "beats": {
      "type": "array",
      "items": { "$ref": "#/$defs/beat" }
    },
    "order": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reorder_logs": {
      "type": "array",
      "items": { "$ref": "#/$defs/reorder_log" }
    },
    "escalations": {
      "type": "array",
      "items": { "$ref": "#/$defs/escalation" }
    },
    "drop_reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "reason"],
        "properties": {
          "candidate_id": { "type": "string" },
          "reason": {
            "enum": [
              "low_evidence",
              "contradictory",
              "redundant",
              "out_of_arc",
              "slate_or_setup",
              "handling_only",
              "low_signal",
              "manual_required"
            ]
          }
        }
      }
    },
    "chronological_status": {
      "enum": ["truthful", "truthful_with_disclosed_reorder", "false_chronology_blocked"]
    },
    "review_flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["flag", "evidence_refs"],
        "properties": {
          "flag": {
            "enum": [
              "human_required",
              "low_confidence",
              "ambiguous",
              "needs_truthfulness_review",
              "needs_brand_review"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "$defs": {
    "beat": {
      "type": "object",
      "required": ["beat_id", "label", "selected_take", "alternates", "confidence", "evidence"],
      "properties": {
        "beat_id": { "type": "string", "minLength": 1 },
        "label": {
          "enum": [
            "hook", "cold_open", "setup", "context", "escalation", "turn",
            "payoff", "resolution", "cta", "summary", "evidence",
            "quote", "demo", "transition"
          ]
        },
        "selected_take": { "type": "string", "minLength": 1 },
        "alternates": { "type": "array", "items": { "$ref": "#/$defs/take_score" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source_range"],
            "properties": {
              "source_range": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "integer", "minimum": 0 }
              },
              "word_ids": { "type": "array", "items": { "type": "string" } },
              "frame_refs": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "take_score": {
      "type": "object",
      "required": ["candidate_id", "scores", "weight_total", "missing_evidence", "hard_faults", "total", "winner_margin"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 },
        "scores": {
          "type": "object",
          "required": ["delivery", "completeness", "technical", "hook_strength", "payoff_strength"],
          "properties": {
            "delivery": { "type": "number", "minimum": 0, "maximum": 1 },
            "completeness": { "type": "number", "minimum": 0, "maximum": 1 },
            "technical": { "type": "number", "minimum": 0, "maximum": 1 },
            "hook_strength": { "type": "number", "minimum": 0, "maximum": 1 },
            "payoff_strength": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "weight_total": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 },
        "winner_margin": { "type": "number" },
        "missing_evidence": {
          "type": "array",
          "items": {
            "enum": ["delivery", "completeness", "technical", "hook_strength", "payoff_strength"]
          }
        },
        "hard_faults": {
          "type": "array",
          "items": {
            "enum": [
              "clipped_word", "source_corruption", "unusable_exposure",
              "unusable_audio", "identity_violation"
            ]
          }
        },
        "status": { "enum": ["eligible", "disqualified", "manual_required"] }
      }
    },
    "escalation": {
      "type": "object",
      "required": ["escalation_id", "kind", "blocking", "summary", "evidence_refs"],
      "properties": {
        "escalation_id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "ambiguous", "low_confidence", "missing_evidence",
            "truthfulness_risk", "second_disagreement", "policy_limit",
            "human_required", "out_of_arc"
          ]
        },
        "blocking": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1 },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "review_mode_target": {
          "enum": ["reviewed", "review-light", "autonomous"]
        },
        "raised_by": {
          "enum": ["deterministic", "director", "critic", "reviewer"]
        }
      }
    },
    "reorder_log": {
      "type": "object",
      "required": ["from_index", "to_index", "reason", "claim_dependencies"],
      "properties": {
        "from_index": { "type": "integer", "minimum": 0 },
        "to_index": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1 },
        "claim_dependencies": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
