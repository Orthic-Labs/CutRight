{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutright.local/schemas/editorial/take-score.schema.v2.json",
  "title": "CutRight v2 take score",
  "type": "object",
  "required": [
    "candidate_id",
    "scores",
    "weight_total",
    "missing_evidence",
    "hard_faults",
    "total",
    "winner_margin"
  ],
  "properties": {
    "candidate_id": { "type": "string", "minLength": 1 },
    "scores": {
      "type": "object",
      "required": [
        "delivery",
        "completeness",
        "technical",
        "hook_strength",
        "payoff_strength"
      ],
      "properties": {
        "delivery": { "type": "number", "minimum": 0, "maximum": 1 },
        "completeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "technical": { "type": "number", "minimum": 0, "maximum": 1 },
        "hook_strength": { "type": "number", "minimum": 0, "maximum": 1 },
        "payoff_strength": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "weights": {
      "type": "object",
      "properties": {
        "delivery": { "type": "number", "minimum": 0 },
        "completeness": { "type": "number", "minimum": 0 },
        "technical": { "type": "number", "minimum": 0 },
        "hook_strength": { "type": "number", "minimum": 0 },
        "payoff_strength": { "type": "number", "minimum": 0 }
      }
    },
    "weight_total": { "type": "number", "minimum": 0 },
    "total": { "type": "number", "minimum": 0 },
    "winner_margin": { "type": "number" },
    "missing_evidence": {
      "type": "array",
      "items": {
        "enum": ["delivery", "completeness", "technical", "hook_strength", "payoff_strength"]
      }
    },
    "hard_faults": {
      "type": "array",
      "items": {
        "enum": [
          "clipped_word",
          "source_corruption",
          "unusable_exposure",
          "unusable_audio",
          "identity_violation"
        ]
      }
    },
    "status": {
      "enum": ["eligible", "disqualified", "manual_required"]
    }
  }
}
