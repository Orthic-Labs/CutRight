{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cutright.dev/schemas/creative/asset-request.schema.v2.json",
  "title": "CutRight v2 creative asset request",
  "description": "Asset request issued by skill planners (e.g. Designer). Defines asset kind, purpose, exact dimensions/aspects, alpha, duration, source/evidence links, text slots, brand refs, safe/protected zones, identity/OCR locks, allowed transformations and required variants. Timeline/cut fields are not writable through this request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "asset_request_id",
    "asset_request_revision",
    "kind",
    "purpose",
    "outputs",
    "protected",
    "brand",
    "evidence",
    "allowed_transforms",
    "timeline_writable"
  ],
  "properties": {
    "schema": { "const": "cutright.asset_request/v2" },
    "asset_request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "asset_request_revision": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "still_image",
        "vector_graphic",
        "title_card",
        "lower_third",
        "end_card",
        "thumbnail",
        "og_card",
        "caption_track",
        "music_track",
        "sfx_track",
        "voiceover_track",
        "procedural_animation",
        "transition"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["output_id", "width", "height", "aspect", "alpha", "duration_ms", "format"],
        "properties": {
          "output_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
          "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
          "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
          "aspect": {
            "type": "string",
            "pattern": "^[0-9]+:[0-9]+$",
            "description": "Aspect ratio as 'W:H'. Must match width/height to within rounding."
          },
          "alpha": { "enum": ["opaque", "straight", "premultiplied"] },
          "duration_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
          "format": {
            "enum": ["png", "jpeg", "webp", "svg", "mp4_h264", "mp4_av1", "wav_pcm24", "flac", "mp3", "ogg", "ttml", "srt", "vtt", "json"]
          },
          "color_space": { "enum": ["srgb", "rec709", "rec2020", "display_p3", "linear_srgb"] },
          "bit_depth": { "enum": ["8", "10", "16", "24"] },
          "variants": {
            "type": "array",
            "items": { "type": "string", "maxLength": 256 }
          }
        }
      }
    },
    "protected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safe_zones", "identity_locks", "label_locks", "wardrobe_locks", "product_locks"],
      "properties": {
        "safe_zones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "x", "y", "width", "height"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 64 },
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 },
              "width": { "type": "number", "minimum": 0, "maximum": 1 },
              "height": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "identity_locks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject_id", "policy"],
            "properties": {
              "subject_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
              "policy": { "enum": ["no_change", "color_only", "pose_only", "wardrobe_only"] },
              "evidence_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" }
            }
          }
        },
        "label_locks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "evidence_id"],
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 256 },
              "evidence_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
              "tolerance": { "enum": ["exact", "near", "loose"], "default": "exact" }
            }
          }
        },
        "wardrobe_locks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject_id", "evidence_id"],
            "properties": {
              "subject_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
              "evidence_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" }
            }
          }
        },
        "product_locks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["product_id", "evidence_id"],
            "properties": {
              "product_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
              "evidence_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" }
            }
          }
        }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brand_card_ref"],
      "properties": {
        "brand_card_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["brand_card_id", "brand_card_revision"],
          "properties": {
            "brand_card_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
            "brand_card_revision": { "type": "integer", "minimum": 1 }
          }
        },
        "style_direction_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "kind"],
        "properties": {
          "evidence_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
          "kind": {
            "enum": [
              "transcript_segment",
              "frame",
              "audio_segment",
              "face_track",
              "logo_track",
              "label_track",
              "saliency_map",
              "document",
              "brand_card",
              "style_direction"
            ]
          }
        }
      }
    },
    "text_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot_id", "role"],
        "properties": {
          "slot_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
          "role": { "enum": ["title", "subtitle", "caption", "lower_third", "end_card", "watermark", "score", "stat"] },
          "max_chars": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "max_lines": { "type": "integer", "minimum": 1, "maximum": 16 }
        }
      }
    },
    "allowed_transforms": {
      "type": "array",
      "items": {
        "enum": [
          "scale",
          "reframe",
          "crop",
          "color_grade",
          "text_animate",
          "vector_path_edit",
          "transition",
          "audio_mix",
          "audio_fade",
          "audio_eq",
          "music_ducking",
          "transient_align",
          "reverb_throw"
        ]
      }
    },
    "timeline_writable": { "const": false }
  }
}
