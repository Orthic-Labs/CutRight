{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cutright.dev/schemas/creative/brand-card.schema.v2.json",
  "title": "CutRight v2 BrandCard",
  "description": "Authoritative voice, visual tokens, typography, palette, marks, motion language, audio identity, restrictions, accessibility and provenance for a single venture. Locked brand assets are immutable; revisions produce new ids.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "brand_card_id",
    "brand_card_revision",
    "venture_id",
    "voice",
    "visual_tokens",
    "typography",
    "palette",
    "marks",
    "motion_language",
    "audio_identity",
    "restrictions",
    "accessibility",
    "provenance",
    "locked_assets"
  ],
  "properties": {
    "schema": { "const": "cutright.brand_card/v2" },
    "brand_card_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "brand_card_revision": { "type": "integer", "minimum": 1 },
    "venture_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tone", "register", "taboo_terms", "signature_phrases"],
      "properties": {
        "tone": { "type": "string", "minLength": 1, "maxLength": 256 },
        "register": { "enum": ["casual", "neutral", "formal", "technical", "editorial", "promotional"] },
        "taboo_terms": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "signature_phrases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "examples": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    },
    "visual_tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_color", "secondary_color", "accent_color", "surface_color", "ink_color"],
      "properties": {
        "primary_color": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$" },
        "secondary_color": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$" },
        "accent_color": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$" },
        "surface_color": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$" },
        "ink_color": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$" },
        "gradients": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "stops"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 64 },
              "stops": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["color", "at"],
                  "properties": {
                    "color": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$" },
                    "at": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                }
              }
            }
          }
        },
        "textures": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_font_stack", "secondary_font_stack", "weights", "scale"],
      "properties": {
        "primary_font_stack": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "secondary_font_stack": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "mono_font_stack": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "weights": {
          "type": "array",
          "items": { "enum": ["100", "200", "300", "400", "500", "600", "700", "800", "900"] }
        },
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "required": ["body", "display", "caption"],
          "properties": {
            "body": { "type": "integer", "minimum": 8, "maximum": 96 },
            "display": { "type": "integer", "minimum": 16, "maximum": 256 },
            "caption": { "type": "integer", "minimum": 6, "maximum": 64 }
          }
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles"],
      "properties": {
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["background", "foreground", "muted", "highlight"],
          "properties": {
            "background": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$" },
            "foreground": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$" },
            "muted": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$" },
            "highlight": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$" }
          }
        },
        "semantic_tokens": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-FA-F0-9]{8})$" }
        }
      }
    },
    "marks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "clearspace"],
      "properties": {
        "primary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hash", "format"],
          "properties": {
            "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "format": { "enum": ["svg", "png", "webp"] },
            "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "locked": { "const": true }
          }
        },
        "secondary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hash", "format"],
          "properties": {
            "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "format": { "enum": ["svg", "png", "webp"] },
            "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "height": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "locked": { "const": true }
          }
        },
        "clearspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["margin_x", "margin_y"],
          "properties": {
            "margin_x": { "type": "number", "minimum": 0, "maximum": 1 },
            "margin_y": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "motion_language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrance", "exit", "loop"],
      "properties": {
        "entrance": { "type": "string", "minLength": 1, "maxLength": 256 },
        "exit": { "type": "string", "minLength": 1, "maxLength": 256 },
        "loop": { "type": "string", "minLength": 1, "maxLength": 256 },
        "easing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["standard", "expressive"],
          "properties": {
            "standard": { "type": "string", "minLength": 1, "maxLength": 128 },
            "expressive": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        "durations_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fast", "base", "slow"],
          "properties": {
            "fast": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "base": { "type": "integer", "minimum": 1, "maximum": 30000 },
            "slow": { "type": "integer", "minimum": 1, "maximum": 60000 }
          }
        }
      }
    },
    "audio_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signature_sound", "voice_print"],
      "properties": {
        "signature_sound": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hash", "format"],
          "properties": {
            "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "format": { "enum": ["wav_pcm24", "flac", "mp3", "ogg"] },
            "locked": { "const": true }
          }
        },
        "voice_print": {
          "type": "object",
          "additionalProperties": false,
          "required": ["speaker_id", "evidence_id"],
          "properties": {
            "speaker_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
            "evidence_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" }
          }
        },
        "music_bed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mood_tags"],
          "properties": {
            "mood_tags": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 64 }
            },
            "tempo_bpm_range": {
              "type": "object",
              "additionalProperties": false,
              "required": ["min", "max"],
              "properties": {
                "min": { "type": "integer", "minimum": 1, "maximum": 300 },
                "max": { "type": "integer", "minimum": 1, "maximum": 300 }
              }
            }
          }
        }
      }
    },
    "restrictions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colour_combinations_forbidden", "logo_distortion_forbidden", "voice_alteration_forbidden"],
      "properties": {
        "colour_combinations_forbidden": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["foreground", "background"],
            "properties": {
              "foreground": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$" },
              "background": { "type": "string", "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$" }
            }
          }
        },
        "logo_distortion_forbidden": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
        "voice_alteration_forbidden": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_contrast_ratio", "captions_required", "reduced_motion_alternative"],
      "properties": {
        "min_contrast_ratio": { "type": "number", "minimum": 1, "maximum": 21 },
        "captions_required": { "type": "boolean" },
        "reduced_motion_alternative": { "type": "boolean" },
        "color_blindness_safe": { "type": "array", "items": { "enum": ["protanopia", "deuteranopia", "tritanopia", "achromatopsia"] } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "creator", "signed_creative_pack_id"],
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "creator": { "type": "string", "minLength": 1, "maxLength": 256 },
        "signed_creative_pack_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
        "signed_creative_pack_revision": { "type": "integer", "minimum": 1 }
      }
    },
    "locked_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "hash"],
        "properties": {
          "kind": { "enum": ["mark", "signature_sound", "voice_print", "logo_lockup", "wordmark"] },
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
          "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
