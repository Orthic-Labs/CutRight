{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cutright.dev/schemas/creative/bakeoff.schema.v2.json",
  "title": "CutRight v2 bake-off",
  "description": "A bake-off groups 3-4 materially divergent style directions evaluated against the same invariant content. Previews bind to exact input hashes; selection record is immutable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bakeoff_id",
    "brand_card_id",
    "brand_card_revision",
    "invariant_content_hash",
    "directions",
    "selected",
    "created_at"
  ],
  "properties": {
    "schema": { "const": "cutright.bakeoff/v2" },
    "bakeoff_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "brand_card_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "brand_card_revision": { "type": "integer", "minimum": 1 },
    "invariant_content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "blake3 hash of the canonical encoded content payload shared by every direction preview."
    },
    "directions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["direction_id", "style_direction_id", "preview_files", "dimensions_changed", "preview_hash"],
        "properties": {
          "direction_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
          "style_direction_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
          "preview_files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "path", "format", "size_bytes", "hash"],
              "properties": {
                "role": { "enum": ["preview", "proxy"] },
                "path": { "type": "string", "pattern": "^[/A-Za-z0-9._-]+$" },
                "format": { "type": "string", "minLength": 1, "maxLength": 32 },
                "size_bytes": { "type": "integer", "minimum": 0 },
                "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            }
          },
          "dimensions_changed": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "palette",
                "typography",
                "texture",
                "composition",
                "motion_language",
                "audio_language",
                "signature_mechanism"
              ]
            }
          },
          "preview_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "render_time_ms": { "type": "integer", "minimum": 0, "maximum": 600000 }
        }
      }
    },
    "selected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "selection_record"],
      "properties": {
        "selected": { "type": "boolean" },
        "selection_record": {
          "type": "object",
          "additionalProperties": false,
          "required": ["direction_id", "preview_hash", "decided_by", "decided_at"],
          "properties": {
            "direction_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
            "preview_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "decided_by": { "type": "string", "minLength": 1, "maxLength": 128 },
            "decided_at": { "type": "string", "format": "date-time" },
            "rationale": { "type": "string", "maxLength": 4096 },
            "applied_role": { "enum": ["primary", "secondary", "exploration"] }
          }
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["direction_id", "reason"],
            "properties": {
              "direction_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
              "reason": { "type": "string", "minLength": 1, "maxLength": 1024 }
            }
          }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
